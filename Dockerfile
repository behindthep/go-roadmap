# ==========================================
# ЭТАП 1: Сборка бинарного файла (Builder)
# ==========================================
FROM golang:1.22-alpine AS builder

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы описания зависимостей
COPY go.mod go.sum ./

# Скачиваем зависимости (они закешируются, если go.mod не менялся)
RUN go mod download

# Копируем весь исходный код проекта
COPY . .

# Собираем легковесный статический бинарник под Linux
# - CGO_ENABLED=0 отключает зависимости от C-библиотек (нужно для альпайна/скрэтча)
# - ldflags="-s -w" удаляет отладочную информацию и символы (уменьшает размер файла на ~30%)
# предполагается, что ваш главный файл называется main.go и лежит в корне. Если у вас проект организован иначе (например, точка входа лежит в cmd/app/main.go), просто замените этот путь на ваш: ... -o /app/main ./cmd/app/main.go.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/main ./main.go

# ==========================================
# ЭТАП 2: Финальный минимальный образ
# ==========================================
FROM alpine:3.19

WORKDIR /root/

# Устанавливаем сертификаты безопасности (необходимы, если ваше Go-приложение делает запросы по HTTPS)
RUN apk --no-cache add ca-certificates

# Копируем только скомпилированный рабочий бинарник из первого этапа
COPY --from=builder /app/main .

# Указываем порт, который слушает ваше приложение (например, 8080)
EXPOSE 8080

# Команда для запуска приложения при старте контейнера
CMD ["./main"]
